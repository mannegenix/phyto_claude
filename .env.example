# Copy to .env.local for `npm run dev`. On Cloudflare: NEXT_PUBLIC_* go in Build variables,
# secrets go in Worker → Settings → Variables and Secrets (see README → Deploying to Cloudflare).
# For `npm run preview` (local Workers runtime) put secrets in .dev.vars (see .dev.vars.example).
# Every integration is optional in development:
# missing keys degrade gracefully (enquiries are logged instead of emailed, chat is hidden).

# Public site URL (used for metadata, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Client-review switches (leave unset/false in production) ──────────────
NEXT_PUBLIC_SHOW_THEME_SWITCHER=true
NEXT_PUBLIC_SHOW_REVIEW_NOTES=true

# ── Enquiry form → email (https://resend.com, verify phytoelements.in first) ──
RESEND_API_KEY=
ENQUIRY_FROM="Phyto Elements Website <website@phytoelements.in>"
ENQUIRY_TO=sales@phytoelements.in
SAMPLES_CC=samples@phytoelements.in

# ── Spam protection (https://dash.cloudflare.com → Turnstile) ──────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── CRM hand-off: any webhook (Zoho Flow, HubSpot via Make/Zapier, n8n …) ──
CRM_WEBHOOK_URL=

# ── Website assistant (Claude API) ─────────────────────────────────────────
NEXT_PUBLIC_CHAT_ENABLED=false
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5
