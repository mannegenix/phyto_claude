{
  // Cloudflare Workers config for the OpenNext adapter.
  // Deployed with Workers Builds (Workers & Pages → Create → Import a repository) or `npm run deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phytoelements-claude",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference used by OpenNext for cache revalidation. Must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "phytoelements-claude",
    },
  ],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Non-secret runtime variables. Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY, ANTHROPIC_API_KEY,
  // CRM_WEBHOOK_URL) go in the dashboard: Worker → Settings → Variables and Secrets, or `npx wrangler secret put`.
  "vars": {
    "ENQUIRY_FROM": "Phyto Elements Website <website@phytoelements.in>",
    "ENQUIRY_TO": "sales@phytoelements.in",
    "SAMPLES_CC": "samples@phytoelements.in",
    "CHAT_MODEL": "claude-haiku-5-5",
  },
}
